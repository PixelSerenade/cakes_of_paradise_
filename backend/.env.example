PORT=5000
MONGODB_URI=your_mongodb_connection_string_here
# Optional Atlas SRV hostname, used to upgrade a legacy multi-host URI if shard DNS changes.
MONGODB_SRV_HOST=your-cluster.mongodb.net
JWT_SECRET=your_jwt_secret_key_here
ADMIN_NAME=Bakery Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-unique-password-of-at-least-12-characters
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace_with_razorpay_test_secret
RAZORPAY_WEBHOOK_SECRET=replace_with_razorpay_webhook_secret
RESEND_API_KEY=re_replace_me
ORDER_EMAIL_FROM=Cakes of Paradise <orders@your-verified-domain.example>
EMAIL_FROM=Cakes of Paradise <orders@your-verified-domain.example>
PUBLIC_SITE_URL=https://your-store-domain.example
PUBLIC_API_URL=https://your-backend-domain.example/api
# Configure Brevo SMTP or any SMTP provider. Keep these values in backend/.env only.
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=your-brevo-smtp-login
BREVO_SMTP_KEY=your-brevo-smtp-key
# Generic SMTP alternatives are also supported:
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-smtp-login
# SMTP_PASS=your-smtp-password
ENQUIRY_NOTIFICATION_TO=hello@your-bakery-domain.example
GMAIL_USER=your-bakery@gmail.com
GMAIL_APP_PASSWORD=your-google-app-password
WHATSAPP_TOKEN=replace_with_meta_whatsapp_cloud_api_token
WHATSAPP_PHONE_NUMBER_ID=replace_with_meta_phone_number_id
WHATSAPP_TEMPLATE_NAME=cake_order_update
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_GRAPH_VERSION=v21.0
BAKERY_PINCODE=575014
BAKERY_PICKUP_ADDRESS=Cakes of Paradise, Surathkal, Mangaluru, Karnataka 575014, India
MAPPLS_API_KEY=replace_with_mappls_geocoding_and_routing_api_key
